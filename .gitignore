*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal

# Pytest cache & test artifacts
.pytest_cache/
.coverage
htmlcov/

# Local backups and export dumps
storage/backups/*.bak.gz
storage/backups/manifest.json
storage/exports/*
*.bak
*.restoring
*.old

# Vector store local cache
data/vector_store/
chroma_db/

# Streamlit local settings
.streamlit/secrets.toml

