# =========================================================================
# HR Analytics AI Report Builder — Production Environment Configuration
# Copy this file to .env and provide real secrets before deployment.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL PASSWORDS TO VERSION CONTROL.
# =========================================================================

# --- Application Environment ---
APP_ENV=production
LOG_LEVEL=INFO
APP_NAME=HR-Analytics-AI-Report-Builder
APP_VERSION=2.0.0

# --- Network & Ports ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501
CORS_ORIGINS=https://hr-reports.company.com,http://localhost:8501

# --- Security & JWT Authentication ---
# MUST be generated via: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Data Encryption Key ---
# AES-256 GCM master key for sensitive credential encryption at rest
ENCRYPTION_MASTER_KEY=replace_with_base64_encoded_32_byte_aes_key

# --- Application Metadata PostgreSQL Database ---
POSTGRES_USER=hr_app_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=hr_analytics_metadata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis Cache & Celery Task Broker ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# --- Target Enterprise HR Database (Read-Only Driver Connection) ---
HR_DB_DIALECT=postgresql
HR_DB_HOST=hr-replica.internal.corp
HR_DB_PORT=5432
HR_DB_NAME=enterprise_hr
HR_DB_USER=hr_bi_readonly
HR_DB_PASSWORD=replace_with_readonly_hr_db_password
HR_DATABASE_URL=${HR_DB_DIALECT}://${HR_DB_USER}:${HR_DB_PASSWORD}@${HR_DB_HOST}:${HR_DB_PORT}/${HR_DB_NAME}

# --- AI Text-to-SQL & LLM Provider ---
DEFAULT_LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=replace_with_google_ai_gemini_api_key
OPENAI_API_KEY=replace_with_openai_api_key_if_using_openai

# --- Vector Database & RAG Storage ---
CHROMA_PERSIST_DIRECTORY=/app/data/vector_store
VECTOR_DB_URL=http://chromadb:8000

# --- Safety, Query Execution Guardrails & SLA ---
QUERY_TIMEOUT_SECONDS=30
MAX_QUERY_ROW_LIMIT=5000
ENFORCE_READ_ONLY=True
AUDIT_LOG_RETENTION_DAYS=730
